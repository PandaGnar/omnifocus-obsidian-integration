# Copy to .env (gitignored) and point at your vault.
# `npm run dev` builds straight into <vault>/.obsidian/plugins/mise-assistant/.
# A leading `~` is expanded to your home directory, so `~/Documents/MyVault`
# works too; anything else is resolved relative to the repo root.
OBSIDIAN_VAULT_PATH=/Users/you/Documents/MyVault
